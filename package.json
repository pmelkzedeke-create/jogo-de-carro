{
  "name": "apex-velocity",
  "private": true,
  "version": "0.1.0",
  "description": "APEX VELOCITY — jogo de corrida 3D para navegador (Three.js + TypeScript + Vite)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "tracks:plot": "vitest run --config vitest.tools.config.ts scripts/plot-tracks.tool.ts",
    "predev": "node scripts/copy-decoders.mjs",
    "prebuild": "node scripts/copy-decoders.mjs",
    "assets:sample-glb": "vitest run --config vitest.tools.config.ts scripts/export-sample-glb.tool.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
